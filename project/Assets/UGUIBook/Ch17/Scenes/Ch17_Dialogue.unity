  m_Lines:
  - speaker: "\u6751\u957F"
    avatar: avatar_4
    text: "\u5E74\u8F7B\u4EBA\uFF0C\u4F60\u603B\u7B97\u6765\u4E86\u3002\u6700\u8FD1\u4E1C\u8FB9\u7684\u68EE\u6797\u91CC\uFF0C<color=#FFB547>\u53F2\u83B1\u59C6</color>\u8D8A\u6765\u8D8A\u591A\uFF0C\u8FDE\u730E\u4EBA\u90FD\u4E0D\u6562\u8FDB\u5C71\u4E86\u3002"
    next: -1
    end: 0
    options: []
  - speaker: "\u6751\u957F"
    avatar: avatar_4
    text: "\u4F60\u613F\u610F\u5E2E\u6211\u4EEC\u6E05\u7406\u6389\u5B83\u4EEC\u5417\uFF1F\u62A5\u916C\u561B\uFF0C\u6751\u91CC\u4E00\u5B9A\u4E0D\u4F1A\u4E8F\u5F85\u4F60\u3002"
    next: -1
    end: 0
    options:
    - text: "\u4EA4\u7ED9\u6211\u5427\uFF01"
      next: 2
    - text: "\u62A5\u916C\u662F\u591A\u5C11\uFF1F"
      next: 3
    - text: "\u6211\u518D\u60F3\u60F3\u3002"
      next: 4
  - speaker: "\u6751\u957F"
    avatar: avatar_4
    text: "\u592A\u597D\u4E86\uFF01\u51FB\u8D25 5 \u53EA\u53F2\u83B1\u59C6\u540E\u56DE\u6765\u627E\u6211\u3002\u8DEF\u4E0A\u5C0F\u5FC3\uFF01"
    next: -1
    end: 1
    options: []
  - speaker: "\u6751\u957F"
    avatar: avatar_4
    text: "500 \u91D1\u5E01\uFF0C\u5916\u52A0\u4E00\u74F6\u7956\u4F20\u7684\u751F\u547D\u836F\u6C34\u3002"
    next: -1
    end: 0
    options:
    - text: "\u6210\u4EA4\uFF01"
      next: 2
    - text: "\u6211\u518D\u60F3\u60F3\u3002"
      next: 4
  - speaker: "\u6751\u957F"
    avatar: avatar_4
    text: "\u5509\u2026\u2026\u90A3\u4F60\u8003\u8651\u597D\u4E86\u518D\u6765\u627E\u6211\u5427\u3002\uFF08\u6309
      T \u91CD\u65B0\u5BF9\u8BDD\uFF09"
    next: -1
    end: 1
    options: []
  m_PlayOnStart: 1
